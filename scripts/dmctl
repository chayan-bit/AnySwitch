#!/usr/bin/env python3
"""Client for the dev input channel of a dev build (make DEVCTL=1 / DEVCTL=1 build_ipa.sh); grammar and protocol in docs/dev-control.md.

  dmctl [--host H] [--port P] [--token T | --log FILE] frame
  dmctl --device UDID --bundle ID --title TID frame                 # an iOS dev build: host and token come from the device
  dmctl ... run 'f900:A wait(30) hold(LUp) wait(60) release'    # sends one sequence, waits until the game has played it, prints the reply
  dmctl ... run -f steps.txt                                       # the sequence from a file (# starts a comment)

The token comes from --token, $DMCTL_TOKEN, or the last "devctl: ... token <hex>" line of --log (the host's stderr / a copied game log).
With --device the host is the device's CoreDevice tunnel address, where the app listens by default, and with --bundle and --title as well the token is
read from that game's log in Hearth, Documents/Logs/<title id>/log.txt, both through devicectl.
Exit status 0 on "ok" / "frame" / "done", 1 on an "err" reply, 2 on a connection or usage problem."""
import argparse
import json
import os
import re
import socket
import subprocess
import sys
import tempfile

TOKEN_RE = re.compile(r'devctl: .* token ([0-9a-f]{32})')


def token_from_log(path):
    tok = None
    with open(path, errors='replace') as f:
        for line in f:
            m = TOKEN_RE.search(line)
            if m: tok = m.group(1)
    return tok


def devicectl_json(*args):
    with tempfile.TemporaryDirectory() as t:
        out = os.path.join(t, 'o.json')
        subprocess.run(['xcrun', 'devicectl', *args, '--json-output', out], check=True, capture_output=True)
        with open(out) as f: return json.load(f)['result']


def device_host(udid):
    return devicectl_json('device', 'info', 'details', '--device', udid)['connectionProperties']['tunnelIPAddress']


def device_log(title):
    """Where Hearth writes a game's log (dm/ios/Sources/main.m)."""
    if not re.fullmatch(r'[0-9A-Fa-f]{16}', title or ''): raise ValueError(f'title id must be 16 hex digits: {title}')
    return f'Documents/Logs/{title.upper()}/log.txt'


def device_token(udid, bundle, title):
    with tempfile.TemporaryDirectory() as t:
        log = os.path.join(t, 'log.txt')
        subprocess.run(['xcrun', 'devicectl', 'device', 'copy', 'from', '--device', udid, '--domain-type', 'appDataContainer',
                        '--domain-identifier', bundle, '--source', device_log(title), '--destination', log], check=True, capture_output=True)
        return token_from_log(log)


def read_sequence(args):
    if args.file:
        with open(args.file) as f:
            text = '\n'.join(l.split('#', 1)[0] for l in f)
    else:
        text = ' '.join(args.steps)
    return ' '.join(text.split())   # one line on the wire


class Channel:
    def __init__(self, host, port, token, timeout):
        self.sock = socket.create_connection((host, port), timeout=10)
        self.sock.settimeout(timeout)
        self.buf = b''
        reply = self.ask('auth ' + token)
        if not reply.startswith('ok '): raise ConnectionError(f'refused: {reply}')
        self.hello = reply

    def ask(self, line):
        self.sock.sendall(line.encode() + b'\n')
        while b'\n' not in self.buf:
            chunk = self.sock.recv(4096)
            if not chunk: raise ConnectionError('channel closed')
            self.buf += chunk
        reply, self.buf = self.buf.split(b'\n', 1)
        return reply.decode()

    def close(self):
        try: self.sock.sendall(b'quit\n')
        except OSError: pass
        self.sock.close()


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--host', default='127.0.0.1')
    ap.add_argument('--device', help='UDID of an iOS device running a dev build: connect through its CoreDevice tunnel')
    ap.add_argument('--bundle', help='with --device and --title: the app bundle id, to read the token from that game\'s log')
    ap.add_argument('--title', help='with --bundle: the title id of the running game (its log is Documents/Logs/<title id>/log.txt)')
    ap.add_argument('--port', type=int, default=int(os.environ.get('DMCTL_PORT', 47800)))
    ap.add_argument('--token', default=os.environ.get('DMCTL_TOKEN'))
    ap.add_argument('--log', help='take the token from this host / app log')
    ap.add_argument('--timeout', type=float, default=600, help='seconds to wait for a reply (a run waits for its last frame)')
    sub = ap.add_subparsers(dest='cmd', required=True)
    sub.add_parser('frame')
    r = sub.add_parser('run')
    r.add_argument('-f', '--file')
    r.add_argument('steps', nargs='*')
    args = ap.parse_args(argv)
    if args.cmd == 'run' and not (args.file or args.steps): ap.error('run wants a sequence or -f FILE')
    try:
        if args.device: args.host = device_host(args.device)
        token = args.token or (token_from_log(args.log) if args.log else None)
        if not token and args.device and args.bundle:
            if not args.title: ap.error('--bundle needs --title: the token is in that game\'s log')
            token = device_token(args.device, args.bundle, args.title)
        if not token: ap.error('no token: pass --token, set DMCTL_TOKEN, point --log at the log that printed it, or give --device, --bundle and --title')
        ch = Channel(args.host, args.port, token, args.timeout)
        reply = ch.ask('frame' if args.cmd == 'frame' else 'run ' + read_sequence(args))
        ch.close()
    except (OSError, ConnectionError, subprocess.CalledProcessError, KeyError, ValueError) as e:
        print(f'dmctl: {e}', file=sys.stderr); return 2
    print(reply)
    return 1 if reply.startswith('err') else 0


if __name__ == '__main__':
    sys.exit(main())
